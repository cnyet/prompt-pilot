# 火山方舟 API Key。
# 留空则自动进入 L1 离线模板模式：功能可走通，生成质量下降，界面会明确提示。
ARK_API_KEY=

# 可选：覆盖默认数据面端点
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 默认模型（生成用 pro，评估用 lite，必须不同族以免自评）
ARK_MODEL_GENERATE=doubao-seed-2-1-pro-260915
ARK_MODEL_EVALUATE=doubao-seed-2-1-lite-260915

# Prisma 的 SQLite 路径按 schema.prisma 所在目录解析，因此要写 ../data 才能落到工程根
# 注意：Prisma CLI 只读 .env，不读 .env.local
DATABASE_URL="file:../data/app.db"
